          }
        }
      }
    },
    "This addon only serves its own catalog IDs (%@), which Nami can't match to its anime library. Use a stream addon that supports IMDb, TMDB, Kitsu, MAL, or AniList IDs.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este complemento solo sirve sus propios ID de catálogo (%@), que Nami no puede asociar con su biblioteca de anime. Usa un complemento de fuentes que admita ID de IMDb, TMDB, Kitsu, MAL o AniList."
          }
        }
