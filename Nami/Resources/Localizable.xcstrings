      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Real-Debrid listo"
          }
        }
      }
    },
    "Instant cached streams in up to 4K, with a manual picker one click away.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuentes en caché al instante en hasta 4K, con el selector manual a un clic."
